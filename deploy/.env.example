# ====== Bắt buộc ======
# Tên miền đã trỏ DNS (bản ghi A) về máy chủ. Caddy tự cấp HTTPS.
DOMAIN=inbox.example.com
ACME_EMAIL=admin@example.com

POSTGRES_USER=omni
POSTGRES_PASSWORD=
POSTGRES_DB=omnichat

# Khoá mã hoá token/bí mật (32 byte base64). Tạo bằng: openssl rand -base64 32
# KHÔNG đổi sau khi đã lưu token, nếu không sẽ không giải mã được.
ENCRYPTION_KEY=

MINIO_ROOT_USER=omnichat
MINIO_ROOT_PASSWORD=
S3_BUCKET=omnichat

# true = cho phép workspace demo với kênh mô phỏng. Nên để false ở môi trường thật.
DEMO_MODE=false

# ====== Meta (Facebook Fanpage) — xem docs/META_SETUP.md ======
META_APP_ID=
META_APP_SECRET=
# Chuỗi tự đặt, khai báo giống hệt trong Meta App Dashboard → Webhooks
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# ====== Zalo OA — xem docs/ZALO_SETUP.md ======
ZALO_APP_ID=
ZALO_APP_SECRET=
# "OA Secret Key" trong mục Webhook của ứng dụng Zalo (dùng kiểm tra chữ ký)
ZALO_OA_SECRET_KEY=
